# WikiMarketing - variaveis de ambiente
#
# Em Coolify, cadastre estas variaveis no app antes do build.
# Como o projeto usa Vite, valores VITE_* entram no bundle durante o build
# da imagem Docker. Alterar depois exige novo deploy/rebuild.

VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="SUA_CHAVE_ANON_PUBLICA"
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_REF"

# Nao coloque SUPABASE_SERVICE_ROLE_KEY no frontend.
# Chaves administrativas ficam somente no Supabase/Edge Functions.
